# ===============================
# DISABLE EXECUTION OF DANGEROUS FILES
# ===============================
<FilesMatch "\.(pl|py|sh|cgi|exe|bat|jar)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow only PHP files to run
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# ===============================
# FAVICON REDIRECT
# ===============================
Redirect 301 /stock_management/favicon.ico /stock_management/img/favicon.ico

# ===============================
# DENY ACCESS TO SENSITIVE DIRECTORIES
# ===============================
# Use FilesMatch instead of DirectoryMatch for .htaccess compatibility
<FilesMatch "\.(inc|ini|conf|cfg)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ===============================
# DISABLE DIRECTORY LISTING
# ===============================
Options -Indexes

# ===============================
# ADDITIONAL SECURITY HEADERS
# ===============================
Header always append X-Frame-Options SAMEORIGIN
Header set X-Content-Type-Options nosniff
Header set X-XSS-Protection "1; mode=block"